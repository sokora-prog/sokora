# ════════════════════════════════════════════════════
#  SOKORA — Variables d'environnement production
#  Copier vers .env.prod et remplir les valeurs
# ════════════════════════════════════════════════════

# ── Domaine ──────────────────────────────────────────
DOMAIN=sokora.ci          # ex: sokora.ci ou api.sokora.ci

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=sokora_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sokora_db

# ── JWT ───────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING

# ── Seed admin (optionnel au premier démarrage) ───────
ADMIN_PHONE=+2250700000000
ADMIN_PASSWORD=CHANGE_ME
